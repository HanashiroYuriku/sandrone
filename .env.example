# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined into the
# browser bundle at build time, so they are PUBLIC — never put secrets in them.

# Build target, read by next.config.ts at build time only:
#   server     — regular Next.js server, `next start` (default; Vercel, Node hosts)
#   standalone — self-contained server for Docker/self-hosting
#   export     — static files in out/ for any static host or CDN
BUILD_OUTPUT=server

# Public URL of this frontend (used for metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the backend REST API. Absolute URL or a path on the same origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# How the API client authenticates: "bearer" (Authorization header) or "cookie" (credentials: include).
NEXT_PUBLIC_AUTH_MODE=bearer

# Serve reference features from the in-browser mock API instead of the real backend.
NEXT_PUBLIC_ENABLE_MOCK_API=true

# Multi-tenant SaaS: send an X-Tenant-ID header and show the tenant switcher.
NEXT_PUBLIC_MULTI_TENANT=false
NEXT_PUBLIC_DEFAULT_TENANT_ID=
