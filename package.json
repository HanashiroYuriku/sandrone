{
  "name": "sandrone",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js frontend template for multi-tenant SaaS, ERP, kiosk/POS and admin dashboards.",
  "author": "Hanashiro Yuriku | Dionisius Geovanni Caesario",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:standalone": "node scripts/build.mjs standalone",
    "build:export": "node scripts/build.mjs export",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@types/node": "^24",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3"
  }
}
